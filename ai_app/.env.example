# Copy to .env and fill in. Same variable names as the KPCL / WB POCs, so their gateway values work here unchanged.
# Internal OpenAI-compatible vLLM gateway (reachable only over the VPN). Leave empty to run without the model:
# the dashboard, verified answers, single-metric lookups, glossary and capability answers still work.
SQL_VERIFY_MODEL=
SQL_VERIFY_BASE_URL=
SQL_VERIFY_API_KEY=
# Optional: CA bundle for the gateway's TLS certificate (TLS is not verified when empty).
AI_MODEL_CA_BUNDLE_PATH=

# RDPR_DB_PATH=            # default: ../DB/rdpr_star.sqlite
RDPR_QUERY_TIMEOUT_SECONDS=60
RDPR_MAX_ROWS=200
RDPR_PROMPT_TOKEN_BUDGET=20000
# Show SQL, routes, timings and error details in the UI / API (admins only).
RDPR_SHOW_TECHNICAL_DETAILS=false

# ---- Voice mode (optional). Speech to text (qwen3-asr) and text to speech (Qwen3-TTS) on the same internal gateway.
# Leave empty to run without voice: the voice button then offers the browser's own voice, and typing still works.
ASR_MODEL=qwen3-asr
ASR_BASE_URL=
ASR_API_KEY=
ASR_CONTEXT_HINTS_ENABLED=true
TTS_ENABLED=false
TTS_MODEL=qwen3-tts
TTS_BASE_URL=
TTS_API_KEY=
TTS_TASK_TYPE=Base
TTS_REF_AUDIO_PATH=voices/officer_serena.wav
TTS_STREAM_ENABLED=true
# Optional: RDPR_VOICE_INSTRUCTIONS (the voice's persona), VOICE_RATE_LIMIT_PER_MINUTE, VOICE_MAX_CONCURRENT_CALLS
